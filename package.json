{
  "name": "@bambiste/countries",
  "version": "0.2.2",
  "description": "Countries as static data, with what a form needs around them: calling codes, names in any language, search, phone numbers, and two form fields, a country select and a phone input.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js",
      "default": "./dist/elements/index.js"
    }
  },
  "files": [
    "dist",
    "src/countries.json",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build",
    "version": "npx -y @changesets/cli version",
    "release": "npx -y @changesets/cli publish",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "countries",
    "iso-3166",
    "country-list",
    "flags",
    "cca2",
    "cca3",
    "web-components",
    "custom-elements",
    "country-select",
    "phone-input"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bambiste/countries.git"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "world-countries": "^5.1.0"
  },
  "sideEffects": [
    "./dist/elements/index.js"
  ]
}
